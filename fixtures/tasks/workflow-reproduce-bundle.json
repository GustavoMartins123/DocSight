{
  "schema": "docsight.task-scenario/v1",
  "id": "workflow-reproduce-bundle",
  "title": "Reproduce one table region offline with bundle and trace",
  "documents": {
    "primary": "sample_tables.docx",
    "reference": null
  },
  "budgets": {
    "max_invocations": 4,
    "max_stdout_bytes": 200000
  },
  "steps": [
    {
      "id": "bundle",
      "args": ["bundle", "{primary}", "--object", "tbl_6fde9f50d14887bd230e213c487c1941", "--include-crop", "--out", "{scratch}/reproduce.dse"],
      "expect_exit": 0,
      "require": ["/result/output_sha256"]
    },
    {
      "id": "verify",
      "args": ["verify", "{scratch}/reproduce.dse"],
      "expect_exit": 0,
      "require": ["/result/verification/valid"],
      "values": {"/result/verification/valid": true}
    },
    {
      "id": "render",
      "args": ["render", "{primary}", "--page", "2", "--dpi", "36", "--out", "{scratch}/reproduce.png", "--trace", "{scratch}/reproduce.dstrace"],
      "expect_exit": 0,
      "require": ["/result/output_sha256"]
    },
    {
      "id": "replay",
      "args": ["replay", "{scratch}/reproduce.dstrace", "--verify"],
      "expect_exit": 0,
      "require": ["/result/verification/valid"],
      "values": {"/result/verification/valid": true}
    }
  ]
}
