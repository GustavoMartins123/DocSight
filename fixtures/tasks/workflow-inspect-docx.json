{
  "schema": "docsight.task-scenario/v1",
  "id": "workflow-inspect-docx",
  "title": "Inspect a DOCX from structure to text to tables",
  "documents": {
    "primary": "sample_tables.docx",
    "reference": null
  },
  "budgets": {
    "max_invocations": 5,
    "max_stdout_bytes": 200000
  },
  "steps": [
    {
      "id": "inspect",
      "args": ["inspect", "{primary}", "--budget", "8kb"],
      "expect_exit": 0,
      "require": ["/result/format", "/result/tables"],
      "values": {"/result/format": "docx"}
    },
    {
      "id": "outline",
      "args": ["outline", "{primary}"],
      "expect_exit": 0,
      "require": ["/result/headings"]
    },
    {
      "id": "text",
      "args": ["text", "{primary}", "--max-items", "10", "--text-limit", "1000"],
      "expect_exit": 0,
      "require": ["/result/blocks"]
    },
    {
      "id": "tables",
      "args": ["tables", "{primary}", "--budget", "8kb"],
      "expect_exit": 0,
      "require": ["/result/tables/0/id"],
      "values": {"/result/tables/0/id": "tbl_6c22c8dd17adf7e32604b29241d9ab99"}
    },
    {
      "id": "fingerprint",
      "args": ["fingerprint", "{primary}"],
      "expect_exit": 0,
      "require": ["/result/file_sha256", "/result/result_fingerprint"]
    }
  ]
}
