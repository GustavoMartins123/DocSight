{
  "schema": "docsight.task-scenario/v1",
  "id": "workflow-verify-support",
  "title": "Verify support and fidelity of one DOCX table document",
  "documents": {
    "primary": "sample_tables.docx",
    "reference": null
  },
  "budgets": {
    "max_invocations": 4,
    "max_stdout_bytes": 200000
  },
  "steps": [
    {
      "id": "inspect",
      "args": ["inspect", "{primary}", "--budget", "8kb"],
      "expect_exit": 0,
      "require": ["/result/format"],
      "values": {"/result/format": "docx"}
    },
    {
      "id": "coverage",
      "args": ["coverage", "{primary}", "--budget", "8kb"],
      "expect_exit": 0,
      "require": ["/result/global/overall_fidelity", "/result/unsupported_feature_count"]
    },
    {
      "id": "evidence",
      "args": ["evidence", "{primary}", "tbl_6c22c8dd17adf7e32604b29241d9ab99"],
      "expect_exit": 0,
      "require": ["/result/object_id", "/result/fidelity"],
      "values": {"/result/object_id": "tbl_6c22c8dd17adf7e32604b29241d9ab99"}
    },
    {
      "id": "fingerprint",
      "args": ["fingerprint", "{primary}"],
      "expect_exit": 0,
      "require": ["/result/file_sha256"]
    }
  ]
}
