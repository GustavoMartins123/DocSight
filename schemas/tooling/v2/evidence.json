{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:docsight:tooling:evidence:v2",
  "title": "DocSight native maintainer evidence contracts v2",
  "description": "Rust maintainer artifact contracts. Validation v2 records native gates with explicit pass, fail, unavailable, blocked and not_run states. Other artifact identifiers retain v1 compatibility. Quality reports measure only the listed documents within their declared classes; an unreviewed ground truth proposal is not reviewed ground truth. Structural validity is not execution, authenticity or human review.",
  "oneOf": [
    {
      "$ref": "#/$defs/beta-report"
    },
    {
      "$ref": "#/$defs/release-manifest"
    },
    {
      "$ref": "#/$defs/smoke-report"
    },
    {
      "$ref": "#/$defs/validation-report"
    },
    {
      "$ref": "#/$defs/corpus-manifest"
    },
    {
      "$ref": "#/$defs/corpus-report"
    },
    {
      "$ref": "#/$defs/readiness-report"
    },
    {
      "$ref": "#/$defs/tooling-error"
    },
    {
      "$ref": "#/$defs/architecture-check"
    },
    {
      "$ref": "#/$defs/document-classes"
    },
    {
      "$ref": "#/$defs/ground-truth"
    },
    {
      "$ref": "#/$defs/quality-report"
    },
    {
      "$ref": "#/$defs/quality-comparison"
    }
  ],
  "$defs": {
    "architecture-check": {
      "additionalProperties": false,
      "properties": {
        "files_checked": {
          "minimum": 0,
          "type": "integer"
        },
        "rust_only": {
          "type": "boolean"
        },
        "schema": {
          "const": "docsight.architecture-check/v1"
        },
        "violations": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "schema",
        "rust_only",
        "files_checked",
        "violations"
      ],
      "type": "object"
    },
    "beta-report": {
      "additionalProperties": false,
      "properties": {
        "archive_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "diagnostic_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{2,79}$",
            "type": "string"
          },
          "maxItems": 512,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "document_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "document_size_bytes": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "elapsed_ms": {
          "maximum": 3600000,
          "minimum": 0,
          "type": "integer"
        },
        "exit_code": {
          "maximum": 4294967295,
          "minimum": -2147483648,
          "type": "integer"
        },
        "experience": {
          "enum": [
            "clear",
            "confusing",
            "blocked"
          ]
        },
        "operation": {
          "enum": [
            "capabilities",
            "inspect",
            "overview",
            "text",
            "render",
            "diff"
          ]
        },
        "outcome": {
          "enum": [
            "success",
            "error",
            "crash",
            "timeout",
            "output_limit",
            "invalid_protocol"
          ]
        },
        "participant": {
          "pattern": "^beta-[0-9]{3}$",
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "schema": {
          "const": "docsight.beta-report/v1"
        },
        "stderr_bytes": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "stdout_bytes": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "target": {
          "enum": [
            "x86_64-pc-windows-msvc",
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu",
            "x86_64-apple-darwin",
            "aarch64-apple-darwin"
          ]
        },
        "unknown_diagnostic_count": {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "schema",
        "version",
        "revision",
        "target",
        "archive_sha256",
        "participant",
        "operation",
        "experience",
        "outcome",
        "exit_code",
        "elapsed_ms",
        "stdout_bytes",
        "stderr_bytes",
        "document_size_bytes",
        "document_sha256",
        "diagnostic_codes",
        "unknown_diagnostic_count"
      ],
      "type": "object"
    },
    "corpus-manifest": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "expected": {
                "additionalProperties": false,
                "properties": {
                  "diagnostic_codes": {
                    "items": {
                      "pattern": "^[A-Z][A-Z0-9_]{2,79}$",
                      "type": "string"
                    },
                    "maxItems": 512,
                    "minItems": 0,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "exit_code": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "pointer_equals": {
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    "maxProperties": 64,
                    "propertyNames": {
                      "pattern": "^/",
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "repeat": {
                    "maximum": 3,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "exit_code",
                  "diagnostic_codes",
                  "repeat",
                  "pointer_equals"
                ],
                "type": "object"
              },
              "file": {
                "minLength": 1,
                "type": "string"
              },
              "format": {
                "enum": [
                  "docx",
                  "pdf",
                  "invalid"
                ]
              },
              "class": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,59}$",
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
                "type": "string"
              },
              "operation": {
                "enum": [
                  "inspect",
                  "text",
                  "render",
                  "diff"
                ]
              },
              "origin": {
                "enum": [
                  "synthetic",
                  "consented-real"
                ]
              },
              "reference": {
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "file",
                  "sha256"
                ],
                "type": "object"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "file",
              "sha256",
              "origin",
              "format",
              "class",
              "operation",
              "expected"
            ],
            "type": "object"
          },
          "maxItems": 10000,
          "minItems": 1,
          "type": "array"
        },
        "schema": {
          "const": "docsight.corpus/v2"
        }
      },
      "required": [
        "schema",
        "cases"
      ],
      "type": "object"
    },
    "corpus-report": {
      "additionalProperties": false,
      "properties": {
        "archive_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "cases": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "attempts": {
                "maximum": 3,
                "minimum": 0,
                "type": "integer"
              },
              "diagnostic_codes": {
                "items": {
                  "pattern": "^[A-Z][A-Z0-9_]{2,79}$",
                  "type": "string"
                },
                "maxItems": 512,
                "minItems": 0,
                "type": "array",
                "uniqueItems": true
              },
              "document_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "elapsed_ms": {
                "maximum": 9223372036854775807,
                "minimum": 0,
                "type": "integer"
              },
              "error_code": {
                "anyOf": [
                  {
                    "pattern": "^[A-Z][A-Z0-9_]+$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "format": {
                "enum": [
                  "docx",
                  "pdf",
                  "invalid"
                ]
              },
              "class": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,59}$",
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
                "type": "string"
              },
              "operation": {
                "enum": [
                  "inspect",
                  "text",
                  "render",
                  "diff"
                ]
              },
              "origin": {
                "enum": [
                  "synthetic",
                  "consented-real"
                ]
              },
              "output_sha256": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "reference_sha256": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "origin",
              "format",
              "class",
              "operation",
              "document_sha256",
              "passed",
              "error_code",
              "attempts",
              "elapsed_ms",
              "output_sha256",
              "diagnostic_codes"
            ],
            "type": "object"
          },
          "maxItems": 10000,
          "minItems": 1,
          "type": "array"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "schema": {
          "const": "docsight.corpus-report/v1"
        },
        "target": {
          "enum": [
            "x86_64-pc-windows-msvc",
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu",
            "x86_64-apple-darwin",
            "aarch64-apple-darwin"
          ]
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "schema",
        "version",
        "revision",
        "target",
        "archive_sha256",
        "manifest_sha256",
        "passed",
        "cases"
      ],
      "type": "object"
    },
    "readiness-report": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "error_code": {
                "anyOf": [
                  {
                    "pattern": "^[A-Z][A-Z0-9_]+$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "enum": [
                  "workspace-validation",
                  "five-native-packages",
                  "beta-observations",
                  "broad-corpus",
                  "manual-reviews",
                  "beta-regressions",
                  "known-v1-gaps"
                ]
              },
              "passed": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "passed",
              "error_code"
            ],
            "type": "object"
          },
          "maxItems": 7,
          "minItems": 7,
          "type": "array"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "policy_thresholds": {
          "enum": [
            "engineering-proposal",
            "approved"
          ]
        },
        "ready_for_v1": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "schema": {
          "const": "docsight.readiness/v1"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "schema",
        "version",
        "revision",
        "policy_sha256",
        "policy_thresholds",
        "ready_for_v1",
        "criteria",
        "scope"
      ],
      "type": "object"
    },
    "release-manifest": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "executable": {
                "type": "boolean"
              },
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "size": {
                "maximum": 268435456,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "path",
              "sha256",
              "size",
              "executable"
            ],
            "type": "object"
          },
          "maxItems": 255,
          "minItems": 1,
          "type": "array"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "schema": {
          "const": "docsight.release/v1"
        },
        "target": {
          "enum": [
            "x86_64-pc-windows-msvc",
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu",
            "x86_64-apple-darwin",
            "aarch64-apple-darwin"
          ]
        },
        "toolchain": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "schema",
        "version",
        "revision",
        "target",
        "toolchain",
        "files"
      ],
      "type": "object"
    },
    "revision": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "smoke-report": {
      "additionalProperties": false,
      "properties": {
        "archive_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "checks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "elapsed_ms": {
                "maximum": 3600000,
                "minimum": 0,
                "type": "integer"
              },
              "error_code": {
                "anyOf": [
                  {
                    "pattern": "^[A-Z][A-Z0-9_]+$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "enum": [
                  "version",
                  "capabilities",
                  "docx_inspect",
                  "pdf_inspect",
                  "docx_determinism",
                  "pdf_determinism",
                  "docx_text",
                  "pdf_text",
                  "docx_render",
                  "pdf_render",
                  "identical_diff",
                  "sandbox_inspect",
                  "typed_error",
                  "completion_bash",
                  "completion_elvish",
                  "completion_fish",
                  "completion_powershell",
                  "completion_zsh"
                ]
              },
              "passed": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "passed",
              "error_code",
              "elapsed_ms"
            ],
            "type": "object"
          },
          "maxItems": 18,
          "minItems": 18,
          "type": "array"
        },
        "passed": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "schema": {
          "const": "docsight.release-smoke/v1"
        },
        "target": {
          "enum": [
            "x86_64-pc-windows-msvc",
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu",
            "x86_64-apple-darwin",
            "aarch64-apple-darwin"
          ]
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "schema",
        "version",
        "revision",
        "target",
        "archive_sha256",
        "passed",
        "checks"
      ],
      "type": "object"
    },
    "tooling-error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "schema": {
          "const": "docsight.tooling-error/v1"
        }
      },
      "required": [
        "schema",
        "code",
        "message"
      ],
      "type": "object"
    },
    "validation-report": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "elapsed_ms": {
                "maximum": 9223372036854775807,
                "minimum": 0,
                "type": "integer"
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "name": {
                "enum": [
                  "rust_tooling_tests",
                  "rust_only",
                  "corpus_inventory",
                  "cargo_fmt",
                  "cargo_clippy",
                  "cargo_test",
                  "cargo_build",
                  "ds9_benchmark",
                  "git_diff_check"
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "unavailable",
                  "blocked",
                  "not_run"
                ]
              },
              "stderr_log": {
                "pattern": "^[a-z][a-z0-9_]*\\.stderr\\.log$",
                "type": "string"
              },
              "stderr_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "stdout_log": {
                "pattern": "^[a-z][a-z0-9_]*\\.stdout\\.log$",
                "type": "string"
              },
              "stdout_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "status",
              "reason",
              "exit_code",
              "elapsed_ms",
              "stdout_log",
              "stderr_log",
              "stdout_sha256",
              "stderr_sha256"
            ],
            "type": "object"
          },
          "maxItems": 9,
          "minItems": 9,
          "type": "array"
        },
        "clean_tree_after": {
          "type": "boolean"
        },
        "clean_tree_before": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "same_revision_after": {
          "type": "boolean"
        },
        "schema": {
          "const": "docsight.validation/v2"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "schema",
        "version",
        "revision",
        "clean_tree_before",
        "clean_tree_after",
        "same_revision_after",
        "checks",
        "passed"
      ],
      "type": "object"
    },
    "version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$",
      "type": "string"
    },
    "document-classes": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "docsight.document-classes/v1"
        },
        "note": {
          "minLength": 1,
          "type": "string"
        },
        "classes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,59}$",
                "type": "string"
              },
              "format": {
                "enum": [
                  "docx",
                  "pdf",
                  "invalid"
                ]
              },
              "complexity": {
                "enum": [
                  "simple",
                  "moderate",
                  "complex",
                  "adversarial"
                ]
              },
              "expects_failure": {
                "type": "boolean"
              },
              "description": {
                "minLength": 1,
                "type": "string"
              },
              "signals": {
                "additionalProperties": {
                  "additionalProperties": false,
                  "properties": {
                    "min": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "max": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [],
                  "type": "object"
                },
                "propertyNames": {
                  "enum": [
                    "pages",
                    "paragraphs",
                    "headings",
                    "tables",
                    "figures",
                    "comments"
                  ]
                },
                "type": "object"
              }
            },
            "required": [
              "id",
              "format",
              "complexity",
              "expects_failure",
              "description",
              "signals"
            ],
            "type": "object"
          },
          "maxItems": 200,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "schema",
        "note",
        "classes"
      ],
      "type": "object"
    },
    "quality-observation": {
      "additionalProperties": false,
      "properties": {
        "structure": {
          "additionalProperties": false,
          "properties": {
            "pages": {
              "minimum": 0,
              "type": "integer"
            },
            "paragraphs": {
              "minimum": 0,
              "type": "integer"
            },
            "headings": {
              "minimum": 0,
              "type": "integer"
            },
            "tables": {
              "minimum": 0,
              "type": "integer"
            },
            "figures": {
              "minimum": 0,
              "type": "integer"
            },
            "blocks_by_kind": {
              "additionalProperties": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "object"
            }
          },
          "required": [
            "pages",
            "paragraphs",
            "headings",
            "tables",
            "figures",
            "blocks_by_kind"
          ],
          "type": "object"
        },
        "text": {
          "additionalProperties": false,
          "properties": {
            "blocks": {
              "minimum": 0,
              "type": "integer"
