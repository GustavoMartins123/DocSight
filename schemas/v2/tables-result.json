{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/tables-result.json",
  "title": "TablesResult",
  "type": "object",
  "required": ["tables"],
  "properties": {
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rows", "columns", "review", "source"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+_[0-9a-f]{32}$"
          },
          "page": { "type": ["integer", "null"], "minimum": 1 },
          "rows": { "type": "integer", "minimum": 0 },
          "columns": { "type": "integer", "minimum": 0 },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "detector": { "type": ["string", "null"] },
          "review": { "type": "boolean" },
          "source": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
