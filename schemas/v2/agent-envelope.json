{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/agent-envelope.json",
  "title": "AgentEnvelope",
  "type": "object",
  "required": [
    "schema",
    "engine",
    "document",
    "result",
    "warnings",
    "limits"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "docsight.agent/v2"
    },
    "engine": {
      "type": "string"
    },
    "document": {
      "type": "object",
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^doc_[0-9a-f]{32}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "result": {},
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "truncated"
      ],
      "properties": {
        "truncated": {
          "type": "boolean"
        },
        "text_truncated": {
          "type": "boolean"
        },
        "warnings_truncated": {
          "type": "boolean"
        },
        "continuation_token": {
          "type": [
            "string",
            "null"
          ]
        },
        "total_items": {
          "type": [
            "integer",
            "null"
          ]
        },
        "returned_items": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total_warnings": {
          "type": [
            "integer",
            "null"
          ]
        },
        "returned_warnings": {
          "type": [
            "integer",
            "null"
          ]
        },
        "projection": {
          "$ref": "#/$defs/projection_selection"
        },
        "selected_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "message",
        "effect"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        },
        "object": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "occurrences": {
          "type": "integer",
          "minimum": 2,
          "description": "number of identical diagnostics merged into this record; absent when the diagnostic occurred once"
        }
      },
      "additionalProperties": false
    },
    "projection_selection": {
      "type": "object",
      "required": [
        "adaptive",
        "selected_profile",
        "omitted_evidence"
      ],
      "properties": {
        "adaptive": {
          "type": "boolean"
        },
        "budget_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "requested_profile": {
          "$ref": "#/$defs/projection_selection/$defs/profile"
        },
        "selected_profile": {
          "$ref": "#/$defs/projection_selection/$defs/profile"
        },
        "omitted_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "extended_snippets",
              "full_content",
              "semantic_neighbors",
              "related_objects",
              "geometry",
              "fidelity",
              "provenance",
              "matched_ranges",
              "ranking_components",
              "visual_references",
              "relationship_hints"
            ]
          },
          "uniqueItems": true
        }
      },
      "$defs": {
        "profile": {
          "type": "string",
          "enum": [
            "compact",
            "balanced",
            "rich"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
