{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/diagnostic.json",
  "title": "DiagnosticRecord",
  "type": "object",
  "required": [
    "code",
    "severity",
    "message",
    "effect"
  ],
  "properties": {
    "code": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "warning",
        "error"
      ]
    },
    "message": {
      "type": "string"
    },
    "effect": {
      "type": "string"
    },
    "object": {
      "type": [
        "string",
        "null"
      ]
    },
    "page": {
      "type": [
        "integer",
        "null"
      ]
    },
    "occurrences": {
      "type": "integer",
      "minimum": 2,
      "description": "number of identical diagnostics merged into this record; absent when the diagnostic occurred once"
    }
  },
  "additionalProperties": false
}
