{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/replay-result.json",
  "title": "ReplayResult",
  "type": "object",
  "required": [
    "trace_path",
    "trace_schema",
    "target",
    "decision_coverage",
    "resource_count",
    "glyph_run_count",
    "table_sizing_decision_count",
    "pagination_decision_count",
    "display_operation_count",
    "verification"
  ],
  "properties": {
    "trace_path": { "type": "string", "minLength": 1 },
    "trace_schema": { "const": "docsight.trace/v2" },
    "target": { "$ref": "trace-manifest.json#/$defs/target" },
    "decision_coverage": { "$ref": "trace-manifest.json#/properties/decision_coverage" },
    "resource_count": { "type": "integer", "minimum": 0 },
    "glyph_run_count": { "type": "integer", "minimum": 0 },
    "table_sizing_decision_count": { "type": "integer", "minimum": 0 },
    "pagination_decision_count": { "type": "integer", "minimum": 0 },
    "display_operation_count": { "type": "integer", "minimum": 0 },
    "verification": {
      "type": "object",
      "required": ["schema", "valid", "trace_sha256", "document_sha256", "display_list_sha256", "raster_sha256"],
      "properties": {
        "schema": { "const": "docsight.trace/v2" },
        "valid": { "const": true },
        "trace_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "document_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "display_list_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "raster_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
