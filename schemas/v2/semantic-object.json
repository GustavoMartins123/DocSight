{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/semantic-object.json",
  "title": "SemanticObject",
  "type": "object",
  "required": [
    "id",
    "kind",
    "z_index",
    "reading_order",
    "source",
    "confidence",
    "text_snippet",
    "text_truncated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z_]+_[0-9a-f]{32}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "paragraph",
        "heading",
        "list_item",
        "table",
        "figure",
        "shape",
        "note",
        "unknown",
        "header",
        "footer",
        "watermark",
        "comment_marker",
        "annotation",
        "table_cell",
        "hyperlink"
      ]
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "bbox": {
      "type": "object",
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "properties": {
        "x0": {
          "type": "number"
        },
        "y0": {
          "type": "number"
        },
        "x1": {
          "type": "number"
        },
        "y1": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "z_index": {
      "type": "integer"
    },
    "reading_order": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "text_snippet": {
      "type": "string",
      "maxLength": 240
    },
    "text_truncated": {
      "type": "boolean"
    },
    "continuations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "bbox",
          "text_start_char"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "bbox": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x0",
              "y0",
              "x1",
              "y1"
            ],
            "properties": {
              "x0": {
                "type": "number"
              },
              "y0": {
                "type": "number"
              },
              "x1": {
                "type": "number"
              },
              "y1": {
                "type": "number"
              }
            }
          },
          "text_start_char": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "additionalProperties": false
}
