{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/mcp-policy.json",
  "title": "McpPolicy",
  "type": "object",
  "required": [
    "schema",
    "read_roots",
    "allowed_tools"
  ],
  "properties": {
    "schema": {
      "const": "docsight.mcp-policy/v1"
    },
    "read_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "write_root": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inspect_document",
          "search_document",
          "get_page",
          "get_region",
          "compare_documents",
          "verify_document",
          "get_evidence",
          "replay_bundle",
          "get_overview",
          "get_outline",
          "list_tables",
          "get_table",
          "get_context",
          "resolve_target",
          "get_peek",
          "get_focus",
          "render_crop",
          "create_bundle"
        ]
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576,
          "default": 65536
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 32768,
          "maximum": 8388608,
          "default": 1048576
        },
        "max_document_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864,
          "default": 67108864
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864,
          "default": 16777216
        },
        "max_memory_bytes": {
          "type": "integer",
          "minimum": 67108864,
          "maximum": 805306368,
          "default": 805306368
        },
        "cpu_timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 30
        },
        "wall_timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 120
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
