{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/find-result.json",
  "title": "FindResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pattern",
    "mode",
    "ignore_case",
    "total_matches",
    "searched_objects",
    "geometry_unavailable_matches",
    "matches"
  ],
  "properties": {
    "pattern": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "literal",
        "regex"
      ]
    },
    "ignore_case": {
      "type": "boolean"
    },
    "total_matches": {
      "type": "integer",
      "minimum": 0
    },
    "searched_objects": {
      "type": "integer",
      "minimum": 0
    },
    "geometry_unavailable_matches": {
      "type": "integer",
      "minimum": 0
    },
    "matches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/find_match"
      }
    }
  },
  "$defs": {
    "find_match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "kind",
        "matched",
        "context_before",
        "context_after",
        "source",
        "confidence",
        "diagnostics"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "paragraph",
            "heading",
            "list_item",
            "table",
            "figure",
            "shape",
            "note",
            "unknown",
            "table_cell",
            "header",
            "footer",
            "watermark",
            "comment_marker",
            "annotation",
            "hyperlink"
          ]
        },
        "container_id": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "object",
          "required": [
            "x0",
            "y0",
            "x1",
            "y1"
          ],
          "properties": {
            "x0": {
              "type": "number"
            },
            "y0": {
              "type": "number"
            },
            "x1": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            }
          }
        },
        "matched": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_char",
            "end_char",
            "text"
          ],
          "properties": {
            "start_char": {
              "type": "integer",
              "minimum": 0
            },
            "end_char": {
              "type": "integer",
              "minimum": 0
            },
            "text": {
              "type": "string"
            }
          }
        },
        "context_before": {
          "type": "string"
        },
        "context_after": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
