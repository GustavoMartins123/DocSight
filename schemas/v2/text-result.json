{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/text-result.json",
  "title": "TextResult",
  "type": "object",
  "required": ["blocks"],
  "properties": {
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+_[0-9a-f]{32}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "heading",
              "list_item",
              "paragraph",
              "table",
              "figure",
              "shape",
              "note",
              "unknown"
            ]
          },
          "text": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
