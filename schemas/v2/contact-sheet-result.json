{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/contact-sheet-result.json",
  "title": "ContactSheetResult",
  "type": "object",
  "required": [
    "pages",
    "labels",
    "limits",
    "dpi",
    "columns",
    "rows",
    "width_px",
    "height_px",
    "thumbnail_max_width_px",
    "thumbnail_max_height_px",
    "media_type",
    "output_path",
    "output_sha256",
    "output_bytes"
  ],
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^p\\. [0-9]+$"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "limits": {
      "type": "object",
      "required": [
        "max_pages",
        "max_output_pixels",
        "max_source_pixels"
      ],
      "properties": {
        "max_pages": {
          "const": 64
        },
        "max_output_pixels": {
          "const": 16000000
        },
        "max_source_pixels": {
          "const": 100000000
        }
      },
      "additionalProperties": false
    },
    "dpi": {
      "type": "integer",
      "minimum": 36,
      "maximum": 600
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "rows": {
      "type": "integer",
      "minimum": 1
    },
    "width_px": {
      "type": "integer",
      "minimum": 1
    },
    "height_px": {
      "type": "integer",
      "minimum": 1
    },
    "thumbnail_max_width_px": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "thumbnail_max_height_px": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "media_type": {
      "const": "image/png"
    },
    "output_path": {
      "type": "string",
      "minLength": 1
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
