{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/ndjson-event.json",
  "title": "NdjsonEvent",
  "type": "object",
  "required": [
    "seq",
    "type"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "meta",
        "done",
        "capabilities",
        "warning",
        "page.begin",
        "page.end",
        "inspect",
        "heading",
        "span",
        "overlay",
        "block",
        "table",
        "render",
        "crop",
        "image",
        "link",
        "diff.summary",
        "diff.lineage",
        "diff.semantic",
        "fingerprint",
        "evidence",
        "bundle",
        "replay",
        "verify",
        "coverage.global",
        "coverage.page",
        "hit",
        "query.summary",
        "query.match",
        "overview.summary",
        "overview.landmark",
        "focus.summary",
        "focus.object",
        "focus.visual_reference"
      ]
    }
  }
}
