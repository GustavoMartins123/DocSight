{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/trace-result.json",
  "title": "TraceOutput",
  "type": "object",
  "required": ["output_path", "output_sha256", "output_bytes", "target", "display_list_sha256", "raster_sha256", "decision_coverage"],
  "properties": {
    "output_path": { "type": "string", "minLength": 1 },
    "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "output_bytes": { "type": "integer", "minimum": 1 },
    "target": { "$ref": "trace-manifest.json#/$defs/target" },
    "display_list_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "raster_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision_coverage": { "$ref": "trace-manifest.json#/properties/decision_coverage" }
  },
  "additionalProperties": false
}
