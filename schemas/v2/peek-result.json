{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/peek-result.json",
  "title": "PeekResult",
  "type": "object",
  "required": ["target", "scope_pages", "total_objects", "objects"],
  "properties": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "page"],
          "properties": {
            "kind": { "const": "page" },
            "page": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "start_page", "end_page"],
          "properties": {
            "kind": { "const": "page_range" },
            "start_page": { "type": "integer", "minimum": 1 },
            "end_page": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "object" },
            "id": { "type": "string", "pattern": "^[a-z_]+_[0-9a-f]{32}$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "index", "id"],
          "properties": {
            "kind": { "const": "section" },
            "index": { "type": "integer", "minimum": 1 },
            "id": { "type": "string", "pattern": "^sect_[0-9a-f]{32}$" }
          },
          "additionalProperties": false
        }
      ]
    },
    "scope_pages": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "maxItems": 8
    },
    "total_objects": { "type": "integer", "minimum": 0 },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object", "relationships"],
        "properties": {
          "object": { "$ref": "semantic-object.json" },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "confidence", "provenance"],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "target",
                    "page_range",
                    "parent_heading",
                    "previous",
                    "next",
                    "related_caption",
                    "related_note"
                  ]
                },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "provenance": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
