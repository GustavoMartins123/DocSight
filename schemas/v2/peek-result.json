{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/peek-result.json",
  "title": "PeekResult",
  "type": "object",
  "required": [
    "target",
    "scope_pages",
    "total_objects",
    "objects"
  ],
  "properties": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "page"
          ],
          "properties": {
            "kind": {
              "const": "page"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "start_page",
            "end_page"
          ],
          "properties": {
            "kind": {
              "const": "page_range"
            },
            "start_page": {
              "type": "integer",
              "minimum": 1
            },
            "end_page": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z_]+_[0-9a-f]{32}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "index",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "section"
            },
            "index": {
              "type": "integer",
              "minimum": 1
            },
            "id": {
              "type": "string",
              "pattern": "^sect_[0-9a-f]{32}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "scope_pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "maxItems": 8
    },
    "total_objects": {
      "type": "integer",
      "minimum": 0
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object",
          "relationships"
        ],
        "properties": {
          "object": {
            "$ref": "#/$defs/semantic_object"
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "role",
                "confidence",
                "provenance"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "target",
                    "page_range",
                    "parent_heading",
                    "previous",
                    "next",
                    "related_caption",
                    "related_note"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "provenance": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semantic_object": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "z_index",
        "reading_order",
        "source",
        "confidence",
        "text_snippet",
        "text_truncated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_]+_[0-9a-f]{32}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "paragraph",
            "heading",
            "list_item",
            "table",
            "figure",
            "shape",
            "note",
            "unknown",
            "header",
            "footer",
            "watermark",
            "comment_marker",
            "annotation",
            "table_cell",
            "hyperlink"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "object",
          "required": [
            "x0",
            "y0",
            "x1",
            "y1"
          ],
          "properties": {
            "x0": {
              "type": "number"
            },
            "y0": {
              "type": "number"
            },
            "x1": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "z_index": {
          "type": "integer"
        },
        "reading_order": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "text_snippet": {
          "type": "string",
          "maxLength": 240
        },
        "text_truncated": {
          "type": "boolean"
        },
        "continuations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page",
              "bbox",
              "text_start_char"
            ],
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "bbox": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x0",
                  "y0",
                  "x1",
                  "y1"
                ],
                "properties": {
                  "x0": {
                    "type": "number"
                  },
                  "y0": {
                    "type": "number"
                  },
                  "x1": {
                    "type": "number"
                  },
                  "y1": {
                    "type": "number"
                  }
                }
              },
              "text_start_char": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
