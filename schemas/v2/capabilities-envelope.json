{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/capabilities-envelope.json",
  "title": "CapabilitiesEnvelope",
  "type": "object",
  "required": [
    "schema",
    "engine",
    "result"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "docsight.agent/v2"
    },
    "engine": {
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/capabilities_result"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "capabilities_result": {
      "type": "object",
      "required": [
        "profile",
        "protocol",
        "error_schema",
        "error_channel",
        "invocation_prefix",
        "sandbox",
        "pdf_password",
        "document_formats",
        "output_modes",
        "agent_defaults",
        "limits",
        "coordinate_system",
        "commands",
        "errors",
        "ingestion_limits"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "const": "agent-first-v1"
        },
        "protocol": {
          "type": "string",
          "const": "docsight.agent/v2"
        },
        "error_schema": {
          "type": "string",
          "format": "uri"
        },
        "error_channel": {
          "type": "string",
          "const": "stderr",
          "description": "failed agent requests emit the error envelope on stderr with no bytes on stdout"
        },
        "errors": {
          "$ref": "#/$defs/capabilities_result/$defs/error_contract"
        },
        "invocation_prefix": {
          "type": "string",
          "const": "docsight --agent"
        },
        "sandbox": {
          "type": "object",
          "required": [
            "flag",
            "agent_default",
            "recommended_for_untrusted_input",
            "supported_platforms",
            "enforced_controls",
            "unsupported_platform_behavior",
            "failure_mode"
          ],
          "properties": {
            "flag": {
              "type": "string",
              "const": "--sandbox"
            },
            "agent_default": {
              "type": "boolean",
              "const": false
            },
            "recommended_for_untrusted_input": {
              "type": "boolean",
              "const": true
            },
            "supported_platforms": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "linux",
                  "windows",
                  "macos"
                ]
              },
              "minItems": 1,
              "uniqueItems": true,
              "const": [
                "linux",
                "macos",
                "windows"
              ]
            },
            "enforced_controls": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "memory",
                  "cpu",
                  "network",
                  "filesystem",
                  "isolated_temp_directory",
                  "bounded_output"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "unsupported_platform_behavior": {
              "type": "string",
              "const": "reject"
            },
            "failure_mode": {
              "type": "string",
              "const": "fail_closed"
            }
          },
          "additionalProperties": false
        },
        "pdf_password": {
          "type": "object",
          "required": [
            "flag",
            "applies_to",
            "transport",
            "file_format",
            "maximum_password_bytes",
            "secret_in_argv",
            "secret_persisted",
            "failure_mode"
          ],
          "properties": {
            "flag": {
              "type": "string",
              "const": "--password-file"
            },
            "applies_to": {
              "type": "array",
              "const": [
                "pdf"
              ]
            },
            "transport": {
              "type": "string",
              "const": "file"
            },
            "file_format": {
              "type": "string",
              "minLength": 1
            },
            "maximum_password_bytes": {
              "type": "integer",
              "const": 127
            },
            "secret_in_argv": {
              "type": "boolean",
              "const": false
            },
            "secret_persisted": {
              "type": "boolean",
              "const": false
            },
            "failure_mode": {
              "type": "string",
              "const": "reject"
            }
          },
          "additionalProperties": false
        },
        "document_formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "docx",
              "pdf"
            ]
          },
          "minItems": 1
        },
        "output_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "json",
              "ndjson"
            ]
          },
          "minItems": 1
        },
        "agent_defaults": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coordinate_system": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "summary",
              "invocation",
              "formats",
              "ndjson",
              "ndjson_events",
              "bounded",
              "result_schema",
              "result_root"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "invocation": {
                "type": "string",
                "minLength": 1
              },
              "formats": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ndjson": {
                "type": "boolean"
              },
              "ndjson_events": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "bounded": {
                "type": "boolean"
              },
              "result_schema": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "result_root": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "name of the result field holding the primary payload; null when the result object itself is the payload"
              }
            },
            "additionalProperties": false
          }
        },
        "ingestion_limits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "applies_to",
              "value",
              "unit",
              "effect"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "applies_to": {
                "type": "string"
              },
              "value": {
                "type": "integer",
                "minimum": 1
              },
              "unit": {
                "type": "string"
              },
              "effect": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "$defs": {
        "error_contract": {
          "type": "object",
          "required": [
            "channel",
            "schema",
            "success_exit_code",
            "codes"
          ],
          "properties": {
            "channel": {
              "type": "string",
              "enum": [
                "stderr"
              ]
            },
            "schema": {
              "type": "string"
            },
            "success_exit_code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "codes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "code",
                  "exit_code",
                  "meaning"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "exit_code": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 255
                  },
                  "meaning": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
