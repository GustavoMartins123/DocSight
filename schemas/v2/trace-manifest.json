{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docsight.dev/schemas/v2/trace-manifest.json",
  "title": "TraceManifest",
  "type": "object",
  "required": [
    "schema",
    "source",
    "fingerprint",
    "target",
    "decision_coverage",
    "resources",
    "glyph_runs",
    "table_sizing",
    "pagination",
    "display_list",
    "raster",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "docsight.trace/v1" },
    "source": {
      "type": "object",
      "required": ["document_id", "document_sha256", "format", "bytes"],
      "properties": {
        "document_id": { "type": "string", "pattern": "^doc_[0-9a-f]{32}$" },
        "document_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "format": { "enum": ["docx", "pdf"] },
        "bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "fingerprint": {
      "type": "object",
      "required": ["engine", "ooxml_engine", "pdf_engine", "raster_engine", "fonts", "layout_profile", "result_fingerprint"],
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "ooxml_engine": { "type": "string", "minLength": 1 },
        "pdf_engine": { "type": "string", "minLength": 1 },
        "raster_engine": { "type": "string", "minLength": 1 },
        "fonts": { "type": "string", "minLength": 1 },
        "layout_profile": { "type": "string", "minLength": 1 },
        "result_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "target": { "$ref": "#/$defs/target" },
    "decision_coverage": {
      "type": "object",
      "required": ["resolved_resources", "glyph_metrics", "line_breaks", "table_sizing", "pagination", "display_list_operations"],
      "properties": {
        "resolved_resources": { "type": "boolean" },
        "glyph_metrics": { "type": "boolean" },
        "line_breaks": { "type": "boolean" },
        "table_sizing": { "type": "boolean" },
        "pagination": { "type": "boolean" },
        "display_list_operations": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "target", "content_sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["font", "image", "relationship", "embedded_object"] },
          "name": { "type": "string" },
          "target": { "type": "string" },
          "content_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "glyph_runs": { "type": "array", "items": { "$ref": "#/$defs/glyph_run" } },
    "table_sizing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_id", "page", "bbox", "rows", "columns", "column_widths_pt", "detector"],
        "properties": {
          "object_id": { "type": "string", "minLength": 1 },
          "page": { "type": "integer", "minimum": 1 },
          "bbox": { "$ref": "#/$defs/nullable_bbox" },
          "rows": { "type": "integer", "minimum": 1 },
          "columns": { "type": "integer", "minimum": 1 },
          "column_widths_pt": { "type": ["array", "null"], "items": { "type": "number" } },
          "detector": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "pagination": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_id", "kind", "page", "bbox", "reading_order"],
        "properties": {
          "object_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["paragraph", "heading", "list_item", "table", "figure", "shape", "note", "unknown"] },
          "page": { "type": "integer", "minimum": 1 },
          "bbox": { "$ref": "#/$defs/nullable_bbox" },
          "reading_order": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "display_list": {
      "type": "object",
      "required": ["page", "page_bbox", "operations", "sha256"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "page_bbox": { "$ref": "#/$defs/bbox" },
        "operations": { "type": "array", "items": { "$ref": "#/$defs/display_operation" } },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "raster": { "$ref": "#/$defs/raster" },
    "warnings": { "type": "array", "items": { "$ref": "diagnostic.json" } }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "required": ["x0", "y0", "x1", "y1"],
      "properties": {
        "x0": { "type": "number" },
        "y0": { "type": "number" },
        "x1": { "type": "number" },
        "y1": { "type": "number" }
      },
      "additionalProperties": false
    },
    "nullable_bbox": {
      "anyOf": [
        { "$ref": "#/$defs/bbox" },
        { "type": "null" }
      ]
    },
    "target": {
      "type": "object",
      "required": ["selector", "page", "bbox", "dpi"],
      "properties": {
        "selector": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "page"],
              "properties": { "kind": { "const": "page" }, "page": { "type": "integer", "minimum": 1 } },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "page", "bbox"],
              "properties": { "kind": { "const": "region" }, "page": { "type": "integer", "minimum": 1 }, "bbox": { "$ref": "#/$defs/bbox" } },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "id"],
              "properties": { "kind": { "const": "object" }, "id": { "type": "string", "minLength": 1 } },
              "additionalProperties": false
            }
          ]
        },
        "page": { "type": "integer", "minimum": 1 },
        "bbox": { "$ref": "#/$defs/bbox" },
        "dpi": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "glyph_run": {
      "type": "object",
      "required": ["text_sha256", "bbox", "font_size_pt", "font_name", "bold", "color_argb"],
      "properties": {
        "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "font_size_pt": { "type": "number", "exclusiveMinimum": 0 },
        "font_name": { "type": "string", "minLength": 1 },
        "bold": { "type": "boolean" },
        "color_argb": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "display_operation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "text_sha256", "bbox", "font_size_pt", "font_name", "bold", "color_argb"],
          "properties": {
            "kind": { "const": "text" },
            "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "bbox": { "$ref": "#/$defs/bbox" },
            "font_size_pt": { "type": "number", "exclusiveMinimum": 0 },
            "font_name": { "type": "string", "minLength": 1 },
            "bold": { "type": "boolean" },
            "color_argb": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "bbox", "color_argb"],
          "properties": {
            "kind": { "const": "border" },
            "bbox": { "$ref": "#/$defs/bbox" },
            "color_argb": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      ]
    },
    "raster": {
      "type": "object",
      "required": ["page", "dpi", "bbox", "width_px", "height_px", "media_type", "sha256", "bytes"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "dpi": { "type": "integer", "minimum": 1 },
        "bbox": { "$ref": "#/$defs/bbox" },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "media_type": { "const": "image/png" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
