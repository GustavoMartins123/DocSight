{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceRecord",
  "type": "object",
  "required": [
    "document_digest",
    "object_id",
    "kind",
    "source_path",
    "z_index",
    "reading_order",
    "fidelity",
    "safe_source_fragment"
  ],
  "properties": {
    "document_digest": { "type": "string" },
    "object_id": { "type": "string" },
    "kind": { "type": "string" },
    "source_path": { "type": "string" },
    "source_offset": { "type": ["integer", "null"] },
    "page": { "type": ["integer", "null"] },
    "bbox": {
      "type": ["object", "null"],
      "properties": {
        "x0": { "type": "number" },
        "y0": { "type": "number" },
        "x1": { "type": "number" },
        "y1": { "type": "number" }
      },
      "required": ["x0", "y0", "x1", "y1"]
    },
    "z_index": { "type": "integer" },
    "reading_order": { "type": "integer" },
    "confidence": { "type": ["number", "null"] },
    "fidelity": {
      "type": "object",
      "required": ["text", "structure", "geometry", "visual", "reasons"],
      "properties": {
        "text": { "type": "number" },
        "structure": { "type": "number" },
        "geometry": { "type": "number" },
        "visual": { "type": "number" },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "render_fingerprint": { "type": ["string", "null"] },
    "safe_source_fragment": { "type": "string" }
  }
}
